#!name=开屏广告拦截
#!desc=基于实际抓包整理｜Shadowrocket 精准广告拦截｜持续更新
#!system=ios

# # 2026-11-12 维护说明
# 专用广告平台采用 DOMAIN-SUFFIX，覆盖其新子域名。
# 业务混合域名仍使用 DOMAIN 精确匹配，避免误伤正常接口。
# URL Rewrite 仅适用于可见的 HTTP 请求；HTTPS 路径匹配需要相应解密配置。

[Rule]

# ==================================================
# 2026-11-12 稳定性优化：广告平台专用域名后缀
# 仅覆盖明确用于广告投放的专用域名，不扩大到业务主域名
# ==================================================
